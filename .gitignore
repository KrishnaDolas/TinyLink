# ================================
# Global Node Ignore
# ================================
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
dist/
.temp/
.cache/

# ================================
# Frontend (Vite + React)
# ================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.DS_Store

# Local env variables
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development

# Log files
frontend/*.log

# Editor-specific
frontend/.vscode/
frontend/.idea/

# ================================
# Backend (Node + Express)
# ================================
backend/node_modules/
backend/*.log
backend/logs/

# Environment files
backend/.env
backend/.env.local
backend/.env.production
backend/.env.development

# Build output (if any)
backend/dist/
backend/.DS_Store

# MongoDB dump directories
dump/
*.dump
*.bak

# ================================
# OS Specific Files
# ================================
.DS_Store
Thumbs.db

# ================================
# IDE Folders
# ================================
.vscode/
.idea/
*.swp
*.swo
